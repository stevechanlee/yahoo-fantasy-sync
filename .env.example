# Personal league configuration is local only. Fill all six fields below.
# The bao/standard selectors are CLI aliases, independent of actual league names.
BAO_LEAGUE_ID=
BAO_LEAGUE_NAME=
BAO_SPREADSHEET_TITLE=
STANDARD_LEAGUE_ID=
STANDARD_LEAGUE_NAME=
STANDARD_SPREADSHEET_TITLE=

# Yahoo application approved for Fantasy Sports READ access (fspt-r).
YAHOO_CLIENT_ID=
YAHOO_CLIENT_SECRET=
# Yahoo supports its documented oob flow: paste the code into the local terminal.
YAHOO_REDIRECT_URI=oob

# Download a Google OAuth Desktop app JSON and store it at this ignored path.
GOOGLE_CLIENT_FILE=.credentials/google-client.json
# Default scope: spreadsheets (no Drive-wide access). Existing IDs are supported.

# Optional: leave blank to create and persist a separate spreadsheet per league.
BAO_SPREADSHEET_ID=
STANDARD_SPREADSHEET_ID=
# Optional only if Yahoo flags multiple teams as owned by you. Full Yahoo team key.
BAO_TEAM_KEY=
STANDARD_TEAM_KEY=
# Comma-separated Yahoo position filters; empty means all positions.
# Each position AND status (FA/W) is paginated independently; union is deduplicated.
PLAYER_POSITIONS=
TRANSACTION_COUNT=100
DATA_DIR=.state
SNAPSHOT_DIR=snapshots
