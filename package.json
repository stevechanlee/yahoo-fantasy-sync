{
  "name": "yahoo-fantasy-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "npm run build && npm test",
    "sync": "node --import tsx src/cli.ts sync",
    "sync:bao": "node --import tsx src/cli.ts sync --league bao",
    "sync:standard": "node --import tsx src/cli.ts sync --league standard",
    "auth:yahoo": "node --import tsx src/cli.ts auth yahoo",
    "auth:google": "node --import tsx src/cli.ts auth google",
    "verify:yahoo": "node --import tsx src/cli.ts verify-yahoo",
    "verify:google": "node --import tsx src/cli.ts verify-google"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "dotenv": "^17.0.0",
    "fast-xml-parser": "^5.0.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/proper-lockfile": "^4.1.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
